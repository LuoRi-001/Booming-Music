<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/titleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layoutDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/progressSlider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/titlesGuideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.5" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:freezesText="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="?textAppearanceHeadline6"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/titlesGuideline"
            app:layout_constraintStart_toEndOf="@+id/favorite"
            app:layout_constraintEnd_toStartOf="@+id/menu"
            tools:text="@tools:sample/lorem" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:gravity="center"
            android:freezesText="true"
            android:singleLine="true"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@+id/titlesGuideline"
            app:layout_constraintStart_toEndOf="@+id/favorite"
            app:layout_constraintEnd_toStartOf="@+id/menu"
            tools:text="@tools:sample/lorem" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favorite"
            style="@style/PlayerIconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_favorite_outline_24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu"
            style="@style/PlayerIconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_more_vert_24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/progressGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/list_pref_guideline_begin"/>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/durationGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/list_pref_guideline_begin"/>

    <com.mardous.booming.ui.component.views.MusicSlider
        android:id="@+id/progressSlider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/titleContainer"
        app:layout_constraintBottom_toTopOf="@+id/functionButtonsRow"
        app:layout_constraintStart_toEndOf="@+id/progressGuideline"
        app:layout_constraintEnd_toStartOf="@+id/durationGuideline"
        tools:progress="50" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/songCurrentProgress"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:textAppearance="?textAppearanceBody2"
        app:layout_constraintTop_toTopOf="@+id/progressSlider"
        app:layout_constraintBottom_toBottomOf="@+id/progressSlider"
        app:layout_constraintEnd_toStartOf="@+id/progressGuideline"
        tools:text="0:01"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/songTotalTime"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:textAppearance="?textAppearanceBody2"
        app:layout_constraintTop_toTopOf="@+id/progressSlider"
        app:layout_constraintBottom_toBottomOf="@+id/progressSlider"
        app:layout_constraintStart_toEndOf="@+id/durationGuideline"
        tools:text="3:00"/>

    <!-- 5 function buttons row: widths proportional to playback buttons below for X alignment -->
    <LinearLayout
        android:id="@+id/functionButtonsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/progressSlider"
        app:layout_constraintBottom_toTopOf="@+id/playPauseButton"
        app:layout_constraintStart_toStartOf="@+id/openQueueButton"
        app:layout_constraintEnd_toEndOf="@+id/loopShuffleButton">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/songInfoButton"
            style="@style/PlayerIconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="56"
            android:contentDescription="@string/action_song_details"
            app:icon="@drawable/ic_info_24dp"
            app:iconSize="22dp"
            app:iconTint="?colorOnSurface"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/soundButton"
            style="@style/PlayerIconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="64"
            android:contentDescription="@string/sound_settings"
            app:icon="@drawable/ic_volume_up_24dp"
            app:iconSize="22dp"
            app:iconTint="?colorOnSurface"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/trackCounter"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="90"
            android:gravity="center"
            android:textAppearance="?textAppearanceBody2"
            android:textColor="?colorOnSurface"
            tools:text="1/15"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sleepTimerButton"
            style="@style/PlayerIconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="64"
            android:contentDescription="@string/action_sleep_timer"
            app:icon="@drawable/ic_timer_24dp"
            app:iconSize="22dp"
            app:iconTint="?colorOnSurface"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tagEditorButton"
            style="@style/PlayerIconButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="56"
            android:contentDescription="@string/action_tag_editor"
            app:icon="@drawable/ic_edit_24dp"
            app:iconSize="22dp"
            app:iconTint="?colorOnSurface"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/playPauseButton"
        style="@style/PlayerIconButton.Large"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginVertical="4dp"
        app:icon="@drawable/ic_play_24dp"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintTop_toBottomOf="@+id/functionButtonsRow"
        app:layout_constraintBottom_toTopOf="@+id/songInfoContainer"
        app:layout_constraintStart_toEndOf="@+id/previousButton"
        app:layout_constraintEnd_toStartOf="@+id/nextButton"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/previousButton"
        style="@style/PlayerIconButton.Medium"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:icon="@drawable/ic_previous_24dp"
        app:layout_constraintTop_toTopOf="@+id/playPauseButton"
        app:layout_constraintBottom_toBottomOf="@+id/playPauseButton"
        app:layout_constraintStart_toEndOf="@+id/openQueueButton"
        app:layout_constraintEnd_toStartOf="@+id/playPauseButton"
        tools:ignore="MissingPrefix"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        style="@style/PlayerIconButton.Medium"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:icon="@drawable/ic_next_24dp"
        app:layout_constraintTop_toTopOf="@+id/playPauseButton"
        app:layout_constraintBottom_toBottomOf="@+id/playPauseButton"
        app:layout_constraintStart_toEndOf="@+id/playPauseButton"
        app:layout_constraintEnd_toStartOf="@+id/loopShuffleButton"
        tools:ignore="MissingPrefix"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openQueueButton"
        style="@style/PlayerIconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/playing_queue_label"
        app:icon="@drawable/ic_queue_music_24dp"
        app:layout_constraintTop_toTopOf="@+id/playPauseButton"
        app:layout_constraintBottom_toBottomOf="@+id/playPauseButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/previousButton"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loopShuffleButton"
        style="@style/PlayerIconButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:icon="@drawable/ic_repeat_24dp"
        app:layout_constraintTop_toTopOf="@+id/playPauseButton"
        app:layout_constraintBottom_toBottomOf="@+id/playPauseButton"
        app:layout_constraintStart_toEndOf="@+id/nextButton"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingPrefix"/>

    <!-- FrameLayout prevents marquee from jittering due to ConstraintLayout re-layouts -->
    <FrameLayout
        android:id="@+id/songInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constrainedWidth="true"
        app:layout_constraintTop_toBottomOf="@+id/playPauseButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/songInfo"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:gravity="center"
            android:freezesText="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:textAppearance="?textAppearanceBody2"
            tools:text="@tools:sample/lorem" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
